# Copy to .env (gitignored) and fill in. Placeholders only here; real values never go in the repo.
# The server refuses to start if a required value is missing or malformed.

# Cloudflare Access (single owner). Required unless DEV_AUTH_BYPASS=1.
# Hostname of the Access team, no scheme:
ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
# Audience tag of the Access application that fronts this app:
ACCESS_AUD=
# The one email address allowed in:
OWNER_EMAIL=you@example.com

# Chat (needs the host gateway; see docs/DEPLOY.md). Without GATEWAY_SOCKET the shell runs and chat is offline.
# Compose variables:
# HUB_UID=1000                              the OS user that owns the gateway socket (the container runs as it)
# HUB_GID=1000
# GATEWAY_SOCKET_DIR=/path/to/hub-gateway   host directory holding gateway.sock (mounted read-only)
# HUB_DATA_DIR=/path/to/hub-data            host directory for the history database, owned by HUB_UID
# App variables (bare node):
# GATEWAY_SOCKET=/path/to/hub-gateway/gateway.sock
# DB_PATH=./data/hub.db
# CHAT_DISABLED=0                           1 is the app-side kill switch for web chat
# CHAT_MAX_PER_MIN=6                        messages per minute across all chats

# Optional
PORT=8787
# Address the server binds to (the container image sets 0.0.0.0; compose publishes on BIND_ADDR).
# HOST=127.0.0.1
# BIND_ADDR=127.0.0.1
# Link-out for the Apollo card (its own app and sign-in). Empty hides the link.
# APOLLO_CHAT_URL=https://apollo-chat.example.com/

# Local development only: skip Access verification. Accepted only when HOST is loopback and
# NODE_ENV is development (or test); the server refuses to start otherwise. Never set this on a deployment.
# NODE_ENV=development
# DEV_AUTH_BYPASS=1
# IMAGE_TAG=latest

# Copy to .env (gitignored) and fill with random values, e.g.:
#   printf 'INGEST_TOKEN=%s\n' "$(openssl rand -hex 24)" >> .env
#   printf 'DASHBOARD_TOKEN=%s\n' "$(openssl rand -hex 24)" >> .env
# The server refuses to start if either is unset, shorter than 20 chars, a placeholder, or identical.
INGEST_TOKEN=
DASHBOARD_TOKEN=

# Optional
PORT=8787
# Deployment mode A (default): behind a TLS reverse proxy on this host.
#   BIND_ADDR=127.0.0.1  COOKIE_SECURE=true  TRUST_PROXY=true
# Deployment mode B: LAN-only plain HTTP (browsers drop Secure cookies over HTTP, so opt out explicitly):
#   BIND_ADDR=<server LAN IP>  COOKIE_SECURE=false  TRUST_PROXY=false
BIND_ADDR=127.0.0.1
RETENTION_DAYS=30
MAX_ROWS=200000
DONE_TO_IDLE_SECONDS=60
STALE_MINUTES=10
# A pipeline run or activity row with no event for this long is shown as abandoned (default 60)
PIPELINE_STALE_MINUTES=60
AGENTS=spec,code,cleanup,server-ops,ask,verify,review
# Display names for parallel instances of one role, lowest free name first (generic names, not identities)
AGENT_NAMES=Ada,Bram,Carl,Dax,Ena,Finn,Gia,Hugo
# A second or later instance card idle for this long is removed (the role card itself is never removed)
INSTANCE_RETIRE_MINUTES=30
COOKIE_SECURE=false
TRUST_PROXY=false

# Further optional settings (defaults shown; see README "Configuration"). Some are read only by bare node,
# and compose passes through only the variables listed in docker-compose.yml.
# HOST=0.0.0.0
# DB_PATH=./data/dashboard.db
# MAX_ATTEMPTS=3
# SESSION_HOURS=12
# MAX_BODY_BYTES=65536
# MAX_SSE_CLIENTS=50
# MAX_AGENTS=100
# MAX_RUNS=50
# INGEST_RATE_PER_MIN=600
# PRICING_FILE=
# OFFICE_LAYOUT_PATH=
# Demo script only (scripts/demo.js)
# DEMO_URL=http://localhost:8787

# Test-only (read by test/office-art.test.js, not by the server): directory of role .md files
# AGENT_DEFINITIONS_DIR=

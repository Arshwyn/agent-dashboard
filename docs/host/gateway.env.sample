# Environment for the hub chat gateway (EnvironmentFile of agent-hub-gateway.service). Placeholders only.
# Absolute path of the orchestrator workspace: the working directory of every web run.
WORKSPACE_DIR=/path/to/orchestrator-workspace
# The gateway's own directory (mode 0700): socket, audit log and the kill-switch file live here by default.
GATEWAY_DATA_DIR=/path/to/hub-gateway
# Optional overrides (defaults shown). The socket path must be 100 bytes or shorter.
# GATEWAY_SOCKET=/path/to/hub-gateway/gateway.sock
# KILL_SWITCH_FILE=/path/to/hub-gateway/DISABLED
# AUDIT_LOG=/path/to/hub-gateway/audit.log
# CLAUDE_BIN=/path/to/claude          absolute path recommended: a systemd service has a short PATH
# PATH=/path/to/bin:/usr/local/bin:/usr/bin:/bin   what the claude process (and its hooks) will see
# GATEWAY_MODEL=
# RUN_TIMEOUT_MS=600000
# MAX_OUT_BYTES=8388608
# KILL_GRACE_MS=3000
# KILL_POLL_MS=1000        how often a run in progress checks the kill switch
# GATEWAY_DISABLED=0       1 turns every web run off (the file flag above does the same without a restart)
